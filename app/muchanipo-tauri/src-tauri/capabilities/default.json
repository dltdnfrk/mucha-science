{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Muchanipo main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "muchanipo-service",
          "sidecar": true
        }
      ]
    }
  ]
}
